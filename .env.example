# Copy this file to .env and replace values as needed. Never commit .env.
DATABASE_URL=postgresql+psycopg://tooldoctor:tooldoctor@localhost:5432/tooldoctor
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000
MONITOR_INTERVAL_SECONDS=86400
PUBLIC_API_URL=http://localhost:5000
VITE_API_URL=http://localhost:3000/api

# Generate fresh secrets for your environment. These are intentionally blank.
AUTH_SECRET=
AUTH_ENCRYPTION_KEY=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_REQUIRED=true

# GitHub public API requests work without a token; an optional fine-grained
# token increases API rate limits. OAuth credentials are for a future OAuth flow.
GITHUB_API_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitLab credentials are configuration only; OAuth is not wired up yet.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Optional email delivery settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional SMS delivery settings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Admin bootstrap settings are not consumed by the current demo authentication.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Tool Doctor Admin
ADMIN_MOBILE=
